# AO Director agent configuration
# Copy this file to .env and fill in your values
# DO NOT commit your actual .env file

# OpenAI API key (or Anthropic for claude-* models)
AO_DIRECTOR_API_KEY=sk-your-key-here

# OpenAI-compatible base URL (leave blank for OpenAI default)
AO_DIRECTOR_BASE_URL=

# Model to use (e.g. openai:gpt-4o, anthropic:claude-sonnet-4-6, openrouter:minimax/minimax-m2)
AO_DIRECTOR_MODEL=openai:gpt-4o
